# TaxTrack Configuration
# Copy this file to .env and adjust values

APP_NAME=TaxTrack
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./taxtrack.db

# AI Models
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.50

# PaddleOCR
PADDLEOCR_LANG=en
PADDLEOCR_USE_GPU=false

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
